{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true, // Agregado para mejorar la interoperabilidad
    "target": "ES2021", // Cambiado a ES2021 para mayor compatibilidad
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false, // Puedes cambiar a "true" si deseas más seguridad
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "strict": false // Mantener en "false" para evitar restricciones excesivas
  }
}