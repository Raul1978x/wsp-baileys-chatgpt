generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  username  String?   @unique
  password  String
  email     String    @unique
  role      UserRole  @default(USER)
  sessions  Session[]
  clients   Client[]
  companies Company[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model Session {
  id          String    @id @default(uuid()) // ID único generado automáticamente
  sessionName String    @unique // Nombre único de la sesión
  isActive    Boolean   @default(false) // Estado de la sesión
  qrCode      String?   // Código QR temporal para iniciar sesión
  userId      String?   // Relación con el modelo User
  user        User?     @relation(fields: [userId], references: [id]) // Relación inversa
  messages    Message[] // Relación con mensajes
  createdAt   DateTime  @default(now()) // Fecha de creación
  updatedAt   DateTime  @updatedAt // Fecha de actualización
  qrGeneratedAt DateTime? // Nuevo campo para saber cuándo se generó el QR

  @@map("sessions") // Mapeo a la tabla "sessions" en la base de datos
}

model Message {
  id         String           @id @default(uuid()) // ID único generado automáticamente
  sessionId  String           // Relación con la sesión de WhatsApp
  session    Session          @relation(fields: [sessionId], references: [id]) // Relación con el modelo Session
  chatId     String           // Identificador del chat (puede ser un número de teléfono o grupo)
  sender     String           // Remitente del mensaje
  content    String           // Contenido del mensaje
  direction  MessageDirection // Dirección del mensaje (enum: INCOMING o OUTGOING)
  status     MessageStatus    @default(PENDING) // Estado del mensaje
  timestamp  DateTime         @default(now()) // Marca de tiempo automática

  @@map("messages") // Mapeo a la tabla "messages" en la base de datos
}

// Enum para la dirección del mensaje
enum MessageDirection {
  INCOMING
  OUTGOING
}

// Enum para el estado del mensaje
enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
}

model Client {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  plan      PlanType
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

enum PlanType {
  FREE
  BASIC
  PREMIUM
}